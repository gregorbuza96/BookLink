# Rendered by Terraform and dropped into k3s' auto-deploy directory.
# registry = ${registry}
---
apiVersion: v1
kind: Namespace
metadata:
  name: booklink
---
apiVersion: v1
kind: Secret
metadata:
  name: booklink-secrets
  namespace: booklink
type: Opaque
stringData:
  db-password: "${db_password}"
  jwt-secret: "${jwt_secret}"
---
# ── PostgreSQL (single instance, 3 logical databases) ─────
apiVersion: v1
kind: ConfigMap
metadata:
  name: postgres-init
  namespace: booklink
data:
  init.sql: |
    CREATE DATABASE booklink_hotels;
    CREATE DATABASE booklink_bookings;
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-data
  namespace: booklink
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: local-path
  resources:
    requests:
      storage: 5Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres
  namespace: booklink
spec:
  replicas: 1
  strategy: { type: Recreate }
  selector: { matchLabels: { app: postgres } }
  template:
    metadata: { labels: { app: postgres } }
    spec:
      containers:
        - name: postgres
          image: postgres:16-alpine
          env:
            - name: POSTGRES_DB
              value: booklink_users
            - name: POSTGRES_USER
              value: booklink
            - name: POSTGRES_PASSWORD
              valueFrom: { secretKeyRef: { name: booklink-secrets, key: db-password } }
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          ports: [{ containerPort: 5432 }]
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
            - name: init
              mountPath: /docker-entrypoint-initdb.d
          resources:
            requests: { memory: "200Mi", cpu: "100m" }
            limits: { memory: "300Mi" }
      volumes:
        - name: data
          persistentVolumeClaim: { claimName: postgres-data }
        - name: init
          configMap: { name: postgres-init }
---
apiVersion: v1
kind: Service
metadata: { name: postgres, namespace: booklink }
spec:
  selector: { app: postgres }
  ports: [{ port: 5432, targetPort: 5432 }]
---
# ── Redis ─────────────────────────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata: { name: redis, namespace: booklink }
spec:
  replicas: 1
  selector: { matchLabels: { app: redis } }
  template:
    metadata: { labels: { app: redis } }
    spec:
      containers:
        - name: redis
          image: redis:7-alpine
          ports: [{ containerPort: 6379 }]
          resources:
            requests: { memory: "32Mi", cpu: "50m" }
            limits: { memory: "64Mi" }
---
apiVersion: v1
kind: Service
metadata: { name: redis, namespace: booklink }
spec:
  selector: { app: redis }
  ports: [{ port: 6379, targetPort: 6379 }]
---
# ── config-server ─────────────────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata: { name: config-server, namespace: booklink }
spec:
  replicas: 1
  selector: { matchLabels: { app: config-server } }
  template:
    metadata: { labels: { app: config-server } }
    spec:
      imagePullSecrets: [{ name: ecr-creds }]
      containers:
        - name: config-server
          image: ${registry}/booklink/config-server:latest
          ports: [{ containerPort: 8888 }]
          env:
            - { name: JAVA_TOOL_OPTIONS, value: "-XX:MaxRAMPercentage=60.0" }
          readinessProbe:
            httpGet: { path: /actuator/health, port: 8888 }
            initialDelaySeconds: 40
            periodSeconds: 10
          resources:
            requests: { memory: "256Mi", cpu: "100m" }
            limits: { memory: "384Mi" }
---
apiVersion: v1
kind: Service
metadata: { name: config-server, namespace: booklink }
spec:
  selector: { app: config-server }
  ports: [{ port: 8888, targetPort: 8888 }]
---
# ── user-service ──────────────────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata: { name: user-service, namespace: booklink }
spec:
  replicas: 1
  selector: { matchLabels: { app: user-service } }
  template:
    metadata: { labels: { app: user-service } }
    spec:
      imagePullSecrets: [{ name: ecr-creds }]
      containers:
        - name: user-service
          image: ${registry}/booklink/user-service:latest
          ports: [{ containerPort: 8081 }]
          env:
            - { name: JAVA_TOOL_OPTIONS, value: "-XX:MaxRAMPercentage=60.0" }
            - { name: CONFIG_SERVER_URL, value: "http://config-server:8888" }
            - { name: DB_HOST, value: "postgres" }
            - { name: DB_USER, value: "booklink" }
            - name: DB_PASSWORD
              valueFrom: { secretKeyRef: { name: booklink-secrets, key: db-password } }
            - name: JWT_SECRET
              valueFrom: { secretKeyRef: { name: booklink-secrets, key: jwt-secret } }
          readinessProbe:
            httpGet: { path: /actuator/health, port: 8081 }
            initialDelaySeconds: 50
            periodSeconds: 10
          resources:
            requests: { memory: "256Mi", cpu: "100m" }
            limits: { memory: "384Mi" }
---
apiVersion: v1
kind: Service
metadata: { name: user-service, namespace: booklink }
spec:
  selector: { app: user-service }
  ports: [{ port: 8081, targetPort: 8081 }]
---
# ── hotel-service ─────────────────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata: { name: hotel-service, namespace: booklink }
spec:
  replicas: 1
  selector: { matchLabels: { app: hotel-service } }
  template:
    metadata: { labels: { app: hotel-service } }
    spec:
      imagePullSecrets: [{ name: ecr-creds }]
      containers:
        - name: hotel-service
          image: ${registry}/booklink/hotel-service:latest
          ports: [{ containerPort: 8082 }]
          env:
            - { name: JAVA_TOOL_OPTIONS, value: "-XX:MaxRAMPercentage=60.0" }
            - { name: CONFIG_SERVER_URL, value: "http://config-server:8888" }
            - { name: DB_HOST, value: "postgres" }
            - { name: DB_USER, value: "booklink" }
            - { name: REDIS_HOST, value: "redis" }
            - name: DB_PASSWORD
              valueFrom: { secretKeyRef: { name: booklink-secrets, key: db-password } }
            - name: JWT_SECRET
              valueFrom: { secretKeyRef: { name: booklink-secrets, key: jwt-secret } }
          readinessProbe:
            httpGet: { path: /actuator/health, port: 8082 }
            initialDelaySeconds: 50
            periodSeconds: 10
          resources:
            requests: { memory: "256Mi", cpu: "100m" }
            limits: { memory: "384Mi" }
---
apiVersion: v1
kind: Service
metadata: { name: hotel-service, namespace: booklink }
spec:
  selector: { app: hotel-service }
  ports: [{ port: 8082, targetPort: 8082 }]
---
# ── booking-service ───────────────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata: { name: booking-service, namespace: booklink }
spec:
  replicas: 1
  selector: { matchLabels: { app: booking-service } }
  template:
    metadata: { labels: { app: booking-service } }
    spec:
      imagePullSecrets: [{ name: ecr-creds }]
      containers:
        - name: booking-service
          image: ${registry}/booklink/booking-service:latest
          ports: [{ containerPort: 8083 }]
          env:
            - { name: JAVA_TOOL_OPTIONS, value: "-XX:MaxRAMPercentage=60.0" }
            - { name: CONFIG_SERVER_URL, value: "http://config-server:8888" }
            - { name: DB_HOST, value: "postgres" }
            - { name: DB_USER, value: "booklink" }
            - { name: HOTEL_SERVICE_URL, value: "http://hotel-service:8082" }
            - { name: USER_SERVICE_URL, value: "http://user-service:8081" }
            - name: DB_PASSWORD
              valueFrom: { secretKeyRef: { name: booklink-secrets, key: db-password } }
            - name: JWT_SECRET
              valueFrom: { secretKeyRef: { name: booklink-secrets, key: jwt-secret } }
          readinessProbe:
            httpGet: { path: /actuator/health, port: 8083 }
            initialDelaySeconds: 50
            periodSeconds: 10
          resources:
            requests: { memory: "256Mi", cpu: "100m" }
            limits: { memory: "384Mi" }
---
apiVersion: v1
kind: Service
metadata: { name: booking-service, namespace: booklink }
spec:
  selector: { app: booking-service }
  ports: [{ port: 8083, targetPort: 8083 }]
---
# ── api-gateway ───────────────────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata: { name: api-gateway, namespace: booklink }
spec:
  replicas: 1
  selector: { matchLabels: { app: api-gateway } }
  template:
    metadata: { labels: { app: api-gateway } }
    spec:
      imagePullSecrets: [{ name: ecr-creds }]
      containers:
        - name: api-gateway
          image: ${registry}/booklink/api-gateway:latest
          ports: [{ containerPort: 8080 }]
          env:
            - { name: JAVA_TOOL_OPTIONS, value: "-XX:MaxRAMPercentage=60.0" }
            - { name: CONFIG_SERVER_URL, value: "http://config-server:8888" }
            - { name: USER_SERVICE_URL, value: "http://user-service:8081" }
            - { name: HOTEL_SERVICE_URL, value: "http://hotel-service:8082" }
            - { name: BOOKING_SERVICE_URL, value: "http://booking-service:8083" }
            - { name: ALLOWED_ORIGINS, value: "*" }
            - name: JWT_SECRET
              valueFrom: { secretKeyRef: { name: booklink-secrets, key: jwt-secret } }
          readinessProbe:
            httpGet: { path: /actuator/health, port: 8080 }
            initialDelaySeconds: 50
            periodSeconds: 10
          resources:
            requests: { memory: "256Mi", cpu: "100m" }
            limits: { memory: "384Mi" }
---
apiVersion: v1
kind: Service
metadata: { name: api-gateway, namespace: booklink }
spec:
  selector: { app: api-gateway }
  ports: [{ port: 8080, targetPort: 8080 }]
---
# ── frontend (Angular + nginx) ────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata: { name: frontend, namespace: booklink }
spec:
  replicas: 1
  selector: { matchLabels: { app: frontend } }
  template:
    metadata: { labels: { app: frontend } }
    spec:
      imagePullSecrets: [{ name: ecr-creds }]
      containers:
        - name: frontend
          image: ${registry}/booklink/frontend:latest
          ports: [{ containerPort: 80 }]
          resources:
            requests: { memory: "32Mi", cpu: "50m" }
            limits: { memory: "64Mi" }
---
apiVersion: v1
kind: Service
metadata: { name: frontend, namespace: booklink }
spec:
  selector: { app: frontend }
  ports: [{ port: 80, targetPort: 80 }]
---
# ── Ingress (k3s built-in Traefik, port 80 on the node) ───
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: booklink
  namespace: booklink
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web
spec:
  rules:
    - http:
        paths:
          - path: /api
            pathType: Prefix
            backend: { service: { name: api-gateway, port: { number: 8080 } } }
          - path: /
            pathType: Prefix
            backend: { service: { name: frontend, port: { number: 80 } } }
